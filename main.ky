// Kyber test file
// Run with 'cargo run main.ky'

// Variables, types, const
let int score = 100;
const float pi = 3.14159;
let bool passing = true;

print(score);
print(pi);
print(passing);

// Arithmetic with int/float promotion
print(7 / 2);        // 3   (integer division truncates)
print(7.0 / 2);      // 3.5 (float division)
print(2 + 3 * 4);    // 14  (precedence)
print((2 + 3) * 4);  // 20  (parens)
print(17 % 5);       // 2   (modulo)

// Comparisons and booleans
print(5 < 10);       // true
print(5 == 5);       // true
print(!passing);     // false
print(3 < 5 == true); // true

// Compound assignment
let int total = 10;
total += 5;
total *= 2;
print(total);        // 30

// if / else if / else
let int grade = 85;
if (grade >= 90) {
    print(4);
} else if (grade >= 80) {
    print(3);        // this runs
} else {
    print(2);
}

// Block scoping (inner shadows outer, doesn't leak)
let int x = 1;
if (true) {
    let int x = 99;  // shadows outer x
    print(x);        // 99
}
print(x);            // 1  (outer x untouched)

// while loop
let int n = 5;
let int factorial_iter = 1;
while (n > 0) {
    factorial_iter *= n;
    n -= 1;
}
print(factorial_iter); // 120

// for loop: ascending, exclusive
for i in 0..5 {
    print(i);        // 0 1 2 3 4
}

// for loop: descending with step
for i in 10..0 by -2 {
    print(i);        // 10 8 6 4 2
}

// for loop: inclusive
for i in 1..=3 {
    print(i);        // 1 2 3
}

// break and continue
for i in 0..10 {
    if (i == 5) { break; }      // stop at 5
    if (i % 2 == 0) { continue; } // skip evens
    print(i);        // 1 3
}

// Functions: parameters, return values
def add(int a, int b) -> int {
    return a + b;
}
print(add(3, 4));    // 7

// Function with a void return
def announce(int value) -> void {
    print(value);
    return;          // early return (bare)
}
announce(42);        // 42

// Recursion: factorial
def factorial(int m) -> int {
    if (m <= 1) {
        return 1;
    }
    return m * factorial(m - 1);
}
print(factorial(6)); // 720

// Recursion: fibonacci
def fib(int k) -> int {
    if (k < 2) {
        return k;
    }
    return fib(k - 1) + fib(k - 2);
}
print(fib(10));      // 55

// return inside a loop exits the whole function
def first_multiple(int of, int limit) -> int {
    for i in 1..=limit {
        if (i % of == 0) {
            return i;   // exits the function, not just the loop
        }
    }
    return 0;           // (no multiple found)
}
print(first_multiple(7, 50)); // 7

// Functions using globals + pass-by-value
let int base = 1000;
def add_to_base(int amount) -> int {
    return base + amount;  // sees the global `base`
}
print(add_to_base(50));    // 1050

def try_modify(int p) -> void {
    p = p + 1;             // modifies the LOCAL copy
    print(p);              // 51
}
let int original = 50;
try_modify(original);
print(original);           // 50  (pass by value - unchanged)